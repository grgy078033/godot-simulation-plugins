activity = &"Reading"

[sub_resource type="Resource" id="Relax"]
script = ExtResource("2")
hour = 16
location_id = &"Cafe"
activity = &"Relaxing"

[sub_resource type="Resource" id="Dinner"]
script = ExtResource("2")
hour = 19
location_id = &"Home"
activity = &"Dinner"

[sub_resource type="Resource" id="Sleep"]
script = ExtResource("2")
hour = 22
location_id = &"Home"
activity = &"Sleeping"

[resource]
script = ExtResource("1")
entries = Array[ExtResource("2")]([SubResource("Walk"), SubResource("Read"), SubResource("Relax"), SubResource("Dinner"), SubResource("Sleep")])
